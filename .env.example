# =====================================================================
#  M3U Translator Subtitle - settings (.env)
#  Copy this file to .env and fill in at least ASR_... and TRANSLATE_...
#  After a change: docker compose up -d
#  The subtitle style can also be changed on the web page /settings.
# =====================================================================

# --- Optional services ---------------------------------------------------
# Also start the NLLB translator on an NVIDIA GPU (see docker-compose.nllb.yml):
#COMPOSE_FILE=docker-compose.yml:docker-compose.nllb.yml

# --- Speech recognition (required: choose one) ----------------------------
# http    = server with an OpenAI-compatible API (/v1/audio/transcriptions)
# command = your own program (gets a WAV file, returns JSON or text)
# plugin  = your own Python file with transcribe(...)
ASR_ENGINE=http
# http: base address of the API, usually ending in /v1
ASR_URL=http://192.168.1.20:8000/v1
ASR_API_KEY=
# name of the model on the server (empty = server default)
ASR_MODEL=
# verbose_json gives sentences with times (recommended); json or text if the server cannot
ASR_RESPONSE_FORMAT=verbose_json
# command: e.g. python3 /config/examples/asr-command-example.py
ASR_COMMAND=
# plugin: e.g. /config/examples/asr-plugin-example.py (test mode without a model)
ASR_PLUGIN=
# seconds to wait per piece; auto = 60% of SEGMENT_SECONDS (the stream never waits longer)
ASR_TIMEOUT=auto
# 1 = the speech recognition can also translate to English (for languages the translator does not know)
ASR_TRANSLATE=1
# 1 = send the previous text as context (sometimes better, sometimes repetitions)
ASR_PROMPT_CONTEXT=0

# --- Translation -----------------------------------------------------------
# libretranslate = LibreTranslate API (also the NLLB service), llm = OpenAI-compatible chat API
TRANSLATE_ENGINE=libretranslate
# libretranslate: address of the server (NLLB service: http://nllb:5000)
TRANSLATE_URL=http://192.168.1.20:5000
TRANSLATE_API_KEY=
TRANSLATE_TIMEOUT=auto
# llm: base address (usually ending in /v1), model and optional key
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=auto
# own instruction for the language model; {src}, {dst} and {n} are filled in (empty = default)
LLM_PROMPT=

# --- Languages ----------------------------------------------------------------
# auto = detect per channel, or one fixed language code for all channels
SOURCE_LANG=auto
TARGET_LANG=nl
# 1 = use lang="xx" from the channel list, 0 = ignore it (detect automatically)
USE_PLAYLIST_LANG=0
# language the translator does not know goes to English first: auto, always or never
ASR_TO_ENGLISH=auto
# these languages always go to English first (comma separated), e.g. sq,ta
VIA_ENGLISH_LANGS=
# only accept these languages in automatic detection (empty = all), e.g. nl,en,fr,de,es,it,pt
LANGUAGE_ALLOWLIST=
# below this language certainty a piece is not shown (only when the server returns a certainty)
LANGUAGE_ACCEPT_PROBABILITY=0.55
# re-check the language after this many pieces
LANGUAGE_RECHECK_CHUNKS=30
LANGUAGE_MIN_PROBABILITY=0.60
LANGUAGE_VOTES=5

# --- Pieces, sentences and voice detection ----------------------------------
SEGMENT_SECONDS=8
OVERLAP_SECONDS=2.0
# lower = more sensitive to speech
VAD_THRESHOLD=0.30
# less speech than this (s) in a piece = silence or music: no speech recognition
MIN_SPEECH_SECONDS=0.3
# 1 = mute parts without speech before sending (less made-up text)
VAD_MUTE=1
MERGE_MAX_CHARS=200
HOLD_UNFINISHED=1
HOLD_MAX_SECONDS=6
OVERLAP_TRIM=1
OVERLAP_FUZZY=0.80

# --- Filters against made-up text (only when the server returns these values) ---
ASR_MAX_COMPRESSION_RATIO=2.6
ASR_NO_SPEECH_PROB=0.75
ASR_MIN_AVG_LOGPROB=-1.0

# --- Subtitles (can also be changed live on /settings) -----------------------
# dvb = subtitle in the stream (on/off in Kodi), track = WebVTT (Kodi 21+), burn = burn in
SUB_MODE=dvb
KODI_STREAM=ts
SUB_LINES=1
SUB_MAX_LINES=2
SUB_CHUNK_LINES=0
SUB_MAX_CHARS=42
SUB_READ_CPS=15
SUB_MIN_SECONDS=1.0
SUB_MAX_DELAY=6
SUB_HOLD=4
SUB_FONT_SIZE=54
SUB_BOX=0
SUB_OUTLINE=8
# empty = DejaVu Sans; own fonts in data/fonts/ (choose them on /settings)
SUB_FONT_FILE=
SUB_POSITION=bottom
SUB_MARGIN=70
SHOW_ORIGINAL=0
SUB_NEW_COLOR=FFFFFF
SUB_OLD_COLOR=E6D2A0

# --- Web interface (http://IP:8088/) --------------------------------------
# Set a password when the web interface is reachable outside your own network
# (the user name does not matter). Kodi needs no password.
WEB_PASSWORD=

# --- Only with SUB_MODE=track ------------------------------------------------
SUB_TRACK_NAME="Dutch (translated)"
LIVE_DELAY=24
START_SEGMENTS=3

# --- Stream and buffer ---------------------------------------------------------
# waiting screen until this many translated pieces are ready (more = fewer stalls, slower zapping)
BUFFER_SEGMENTS=2
# for a new channel wait at most this many seconds for the channel format
PROFILE_WAIT_SECONDS=10
# stop after this many seconds without a viewer
IDLE_STOP=60
# 1080 = at most 1080p; 0 = no limit
MAX_HEIGHT=1080
MAX_HEIGHT_STRICT=1
USER_AGENT="VLC/3.0.20 LibVLC/3.0.20"
OUT_WINDOW=10
INGEST_LIST_SIZE=45
INGEST_DELETE_THRESHOLD=15
QUEUE_WARN_SEGMENTS=5
# from this many waiting pieces on, temporarily no subtitles (0 = never)
MAX_BACKLOG=0

# --- Only with SUB_MODE=burn ------------------------------------------------
# libx264 (CPU) or h264_nvenc (NVIDIA; needs your own image with GPU access)
VIDEO_ENCODER=libx264
VIDEO_BITRATE=6M
DEINTERLACE=1
SUB_SHADOW=0
